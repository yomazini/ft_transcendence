// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

/**
	- This tells Prisma "when I run a command, build me a typed JavaScript/TypeScript library based on whatever models I define below, and put that generated code here (output)."
*/
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
{
  "id": "org-uuid",
  "name": "Acme",
  "plan": "PREMIUM",
  "subscription_status": "ACTIVE",
  "stripe_customer_id": "cus_123",
  "stripe_subscription_id": "sub_123",
  "subscription_start": "2026-10-17T00:00:00Z",
  "subscription_end": "2026-11-17T00:00:00Z",
  "cancel_at_period_end": false
}
*/

model Organization {
  id                String                  @id @default(uuid())
  name              String
  user_organization role_and_organization[]
  description       String
  created_at        DateTime                @default(now())


  // Subscription
  plan               PlanType @default(FREE)
  subscription_status SubscriptionStatus @default(ACTIVE)

  // Stripe references
  stripe_customer_id     String? @unique
  stripe_subscription_id String? @unique

  // Billing period
  subscription_start DateTime?
  subscription_end   DateTime?

  // Cancellation
  cancel_at_period_end Boolean @default(false)
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  password                String
  user_roles_organization role_and_organization[]
  created_at              DateTime                @default(now())
}

model role_and_organization {
  id           String       @id @default(uuid())
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  org_id       String
  role         Roles        @default(Viewer)
}

enum Roles {
  Admin
  Analyst
  Viewer
}

enum PlanType {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}


