generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// BILLING ENUMS
// =====================================================

enum PlanTier {
  free
  premium
  extra
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum SubscriptionStatus {
  active
  canceled
  expired
}

// =====================================================
// BILLING MODELS
// =====================================================

model Subscription {
  id String @id @default(uuid())

  org_id       String
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  plan   PlanTier
  status SubscriptionStatus @default(active)

  started_at DateTime @default(now())
  ends_at    DateTime

  cancel_at_period_end Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  payments Payment[]

  @@index([org_id, status])
  @@index([ends_at])
}

model Payment {
  id String @id @default(uuid())

  org_id       String
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  subscription_id String?
  subscription    Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  plan PlanTier

  amount_cents Int
  currency     String @default("USD")

  status PaymentStatus @default(pending)

  provider_reference String? @unique
  idempotency_key    String? @unique

  failure_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([org_id, created_at])
  @@index([subscription_id])
}

// =====================================================
// ORGANIZATION
// =====================================================

model Organization {
  id   String @id @default(uuid())
  name String

  script_jobs       Job[]
  user_organization role_and_organization[]
  messages          Messages[]

  description String   @db.VarChar(200)
  created_at  DateTime @default(now())

  // Billing
  plan          PlanTier       @default(free)
  subscriptions Subscription[]
  payments      Payment[]
}

// =====================================================
// USER
// =====================================================

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String

  user_roles_organization role_and_organization[]
  messages                Messages[]
  jobs                    Job[]

  two_factor_secret String?
  is_2fa_enabled    Boolean @default(false)
  email_verified    Boolean @default(false)

  created_at DateTime @default(now())
}

// =====================================================
// ORGANIZATION MEMBERSHIP
// =====================================================

model role_and_organization {
  id String @id @default(uuid())

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  org_id       String

  role Roles @default(Viewer)

  @@unique([user_id, org_id])
}

// =====================================================
// COMMENTS
// =====================================================

model Comments {
  id String @id @default(uuid())

  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)
  job_id String

  text    String
  author  String?
  upvotes Int

  sentiment_score Float?
  embedding       Unsupported("vector")?

  created_at DateTime @default(now())
}

// =====================================================
// JOBS
// =====================================================

model Job {
  id String @id @default(uuid())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  org_id       String

  user       User?   @relation(fields: [created_by], references: [id], onDelete: SetNull)
  created_by String?

  target String
  mode   JobModes    @default(Keyword)
  status JobStatuses @default(Running)

  customer_persona Json?

  report   Report?
  comments Comments[]

  created_at DateTime @default(now())
}

enum JobModes {
  Keyword
  Subreddit
  Post
  User
}

enum JobStatuses {
  Queued
  Running
  Done
  Failed
}

// =====================================================
// REPORTS
// =====================================================

model Report {
  id String @id @default(uuid())

  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)
  job_id String @unique

  swot       Json
  blue_ocean Json
  conclusion String?

  created_at DateTime @default(now())
}

// =====================================================
// BACKUPS
// =====================================================

model Backups {
  id String @id @default(uuid())

  fileName String
  filePath String
  s3Key    String?
  fileSize Int?

  status       BackupStatus @default(IN_PROGRESS)
  errorMessage String?

  created_at DateTime @default(now())
}

enum BackupStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
  RESTORED
}

// =====================================================
// ORGANIZATION ROLES
// =====================================================

enum Roles {
  Admin
  Analyst
  Viewer
}

// =====================================================
// MESSAGES
// =====================================================

model Messages {
  id String @id @default(uuid())

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  org_id       String

  response String
  text     String

  read_status Boolean  @default(false)
  created_at  DateTime @default(now())
}

// =====================================================
// PRICE SENSITIVITY
// =====================================================

enum PriceSensitivity {
  budget
  midMarket
  premium
}

