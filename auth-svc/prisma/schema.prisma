// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

/**
	- This tells Prisma "when I run a command, build me a typed JavaScript/TypeScript library based on whatever models I define below, and put that generated code here (output)."
*/
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String                  @id @default(uuid())
  name              String
  user_organization role_and_organization[]
  description       String
  created_at        DateTime                @default(now())
  plan              PlanTier                @default(free)
  subscriptions     Subscription[]
  payments          Payment[]
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  password                String
  user_roles_organization role_and_organization[]
  created_at              DateTime                @default(now())
}

model role_and_organization {
  id           String       @id @default(uuid())
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  org_id       String
  role         Roles        @default(Viewer)
}

enum Roles {
  Admin
  Analyst
  Viewer
}

enum PlanTier {
  free
  premium
  extra
}

enum SubscriptionStatus {
  active
  canceled
  expired
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

model Subscription {
  id                   String             @id @default(uuid())
  org_id               String
  organization         Organization       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  plan                 PlanTier
  status               SubscriptionStatus @default(active)
  started_at           DateTime           @default(now())
  ends_at              DateTime
  cancel_at_period_end Boolean            @default(false)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  payments             Payment[]
}

model Payment {
  id                 String        @id @default(uuid())
  org_id             String
  organization       Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  subscription_id    String?
  subscription       Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  plan               PlanTier
  amount_cents       Int
  currency           String        @default("USD")
  status             PaymentStatus @default(pending)
  provider_reference String?       @unique
  idempotency_key    String?       @unique
  failure_reason     String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
}
