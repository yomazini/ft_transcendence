              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 8,
      "type": "alertlist",
      "title": "Alerts",
      "description": "Rules from prometheus/alerts.yml, read by Grafana. Full list: Alerting > Alert rules.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "datasource": "Prometheus",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": true,
          "error": true,
          "noData": false
        }
      }
    }
  ]
}
