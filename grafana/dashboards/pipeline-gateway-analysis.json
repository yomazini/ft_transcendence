{
  "uid": "ft-pipeline-gateway-analysis",
  "title": "Job pipeline \u2014 gateway + analysis",
  "description": "Owner: Youssef. Jobs created and WebSocket connections (gateway-svc), analysis job results, stage p95 and LLM calls (analysis-svc). The scraper part is in \"Job pipeline \u2014 scraper\".",
  "tags": [
    "ft_transcendence"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ft_transcendence"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Jobs created / min",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "sum(rate(gateway_jobs_created_total[5m]))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ]
