    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of reads served from memory. Below 90% means many reads hit the disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
