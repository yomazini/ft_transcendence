        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"ft_transcendence\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"ft_transcendence\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"ft_transcendence\"}[5m])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
