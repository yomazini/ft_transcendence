meta {
  name: 06 WebSocket Events
  type: ws
  seq: 6
}

ws {
  url: {{ws_url}}
}

body:ws {
  message connect [text] {
    40{"token":"{{token}}"}
  }

  message pong [text] {
    3
  }
}

docs {
  # Socket.IO events

  Connect and wait for the Engine.IO packet `0{...}`.
  Send `connect` to authenticate. A valid token returns `40{"sid":"..."}`.
  Then run `02-Create-Job`. The server sends `42["job:queued",...]` and
  `42["job:update",...]`.
  Send `pong` when the server sends `2`.
}
