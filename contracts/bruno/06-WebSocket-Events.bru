meta {
  name: 06 WebSocket Events
  type: ws
  seq: 6
}

ws {
  url: {{ws_url}}
  body: ws
}

body:ws {
  message 1 [text] {
    40{"token":"{{token}}"}
  }

  message 2 [text] {
    3
  }
}

docs {
  Connect first. Wait for the open packet. Send message 1 to authenticate.
  Send message 2 when the server sends a ping. Then run 02-Create-Job.
}
