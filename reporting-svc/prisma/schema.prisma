// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
	provider = "prisma-client"
	output   = "../src/generated/prisma"
}

datasource db {
	provider = "postgresql"
}

model	Organization {
	id					String		@id @default(uuid())
	name				String
	script_jobs			Job[]
	user_organization	role_and_organization[]
	messages			Messages[]
	description			String
	created_at			DateTime	@default(now())
}

enum PriceSensitivity {
	budget
	midMarket
	premium
}

model	User {
	id							String		@id	@default(uuid())
	email						String		@unique
	password					String
	user_roles_organization		role_and_organization[]
	messages					Messages[]
	jobs						Job[]
	created_at					DateTime	@default(now())
}

model	role_and_organization {
	id				String			@id @default(uuid())
	user			User			@relation(fields: [user_id], references: [id], onDelete: Cascade)
	user_id			String
	organization	Organization	@relation(fields: [org_id], references: [id], onDelete: Cascade)
	org_id			String
	role			Roles			@default(Viewer)
}

model	Comments {
	id				String			@id @default(uuid())
	job				Job	@relation(fields: [job_id], references: [id], onDelete: Cascade)
	job_id			String
	text			String
	author			String
	upvotes			Int
	sentiment_score	Float
	embedding		Unsupported("vector")?
	created_at		DateTime		@default(now())
}

model	Job {
	id				String			@id @default(uuid())
	organization		Organization	@relation(fields: [org_id], references: [id], onDelete: Cascade)
	org_id				String
	user				User?			@relation(fields: [created_by], references: [id], onDelete: SetNull)
	created_by			String?
	target				String
	mode				JobModes		@default(Keyword)
	status				JobStatuses	@default(Running)
	customer_persona	Json
	report				Report?
	comments			Comments[]
	created_at			DateTime		@default(now())
}

enum	JobModes {
	Keyword
	Subreddit
	Post
	User
}

enum	JobStatuses {
	Queued
	Running
	Done
	Failed
}

model	Report {
	id				String			@id	@default(uuid())
	job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)
	job_id String @unique
	swot			Json
	blue_ocean		Json
	conclusion		String
	created_at		DateTime		@default(now())
}

model	Backups {
	id				String			@id	@default(uuid())
	fileName		String
	filePath		String
	s3Key			String?
	fileSize		Int?
	status			BackupStatus	@default(IN_PROGRESS)
	errorMessage	String?
	created_at		DateTime		@default(now())
}

enum	BackupStatus {
	IN_PROGRESS
	SUCCESS
	FAILED
	RESTORED
}

enum	Roles {
	Admin
	Analyst
	Viewer
}

model	Messages {
	id				String			@id	@default(uuid())
	user			User 			@relation(fields: [user_id], references: [id], onDelete: Cascade)
	user_id			String
	organization	Organization	@relation(fields: [org_id], references: [id], onDelete: Cascade)
	org_id			String
	response		String
	text			String
	read_status		Boolean			@default(false)
	created_at		DateTime		@default(now())
}
