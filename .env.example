# Copy to .env and fill in real values. .env itself is git-ignored — never commit it.
POSTGRES_USER=ft_transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ft_transcendence
JWT_SECRET=changeme
GEMINI_API_KEY=changeme
REDDIT_CLIENT_ID=changeme
REDDIT_CLIENT_SECRET=changeme
GRAFANA_ADMIN_PASSWORD=changeme
REDDIT_SESSIONS=changeme,changeme
# Host port of nginx (the site). 42's rootless Docker cannot use ports below 1024.
HTTP_PORT=8080
# --- auth-svc ---
DATABASE_URL=postgresql://ft_transcendence:changeme@postgres:5432/ft_transcendence
FORTYTWO_CLIENT_ID=changeme
FORTYTWO_CLIENT_SECRET=changeme
FORTYTWO_CALLBACK_URL=http://localhost:8080/api/auth/42/callback
FRONTEND_URL=http://localhost:8080
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=changeme
MAIL_PASS=changeme
MAIL_FROM=no-reply@blueocean.local
# --- reporting-svc backups (MinIO) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme-minio
# --- analysis-svc (optional: without it the report uses a built-in fallback) ---
OPENROUTER_API_KEY=changeme
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# --- pgAdmin (database UI, http://localhost:5050) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme

FAKE_BANK_URL=http://fake-bank-api:8080
FAKE_BANK_MERCHANT_ID=insightflow
FAKE_BANK_WEBHOOK_URL=http://auth-svc:3002/orgs/billing/webhook
FAKE_BANK_DB_PASSWORD=changeme
